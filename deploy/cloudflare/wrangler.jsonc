{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threadline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Domain cutover (launch/production/CUTOVER.md): APP_URL → "https://heybell.app", add the routes block, then CANONICAL_HOST.
  "vars": { "APP_URL": "https://threadline.akshitbansal1313.workers.dev" },
  // "routes": [{ "pattern": "heybell.app", "custom_domain": true }],
  // Keep-alive + edge health alert (src/index.ts scheduled()). Cron Triggers are included in Workers Free and Paid.
  "triggers": { "crons": ["*/5 * * * *"] },
  "containers": [
    {
      "class_name": "App",
      "image": "../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "App" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["App"] }]
}
