{
  "name": "threadline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "node --experimental-strip-types packages/db/src/migrate.ts",
    "start:all": "node scripts/start-all.mjs",
    "dev:all": "node scripts/start-all.mjs --dev",
    "worker": "pnpm --filter @threadline/worker start",
    "test:worker": "apps/worker/node_modules/.bin/tsx scripts/test-worker.ts",
    "seed": "apps/worker/node_modules/.bin/tsx scripts/seed.ts",
    "smoke": "bash scripts/smoke.sh",
    "tunnel": "bash scripts/tunnel.sh",
    "backup": "bash scripts/backup.sh"
  }
}
